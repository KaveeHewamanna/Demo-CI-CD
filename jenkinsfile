pipeline {
    agent any

    stages {

        stage('Clone') {
    steps {
        git branch: 'main', url: 'https://github.com/KaveeHewamanna/Demo-CI-CD.git'
    }
}

        stage('Build') {
            steps {
                echo "Building Application..."
            }
        }

        stage('Test') {
            steps {
                echo "Running Tests..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying Application..."
            }
        }

    }
}
