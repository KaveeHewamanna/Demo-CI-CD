pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Code is pulled from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Application Build Successful'
            }
        }

        stage('Test') {
            steps {
                echo 'QA Tests Passed'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Application Deployed Successfully'
            }
        }

    }
}
